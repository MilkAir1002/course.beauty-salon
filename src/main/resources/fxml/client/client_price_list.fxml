<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="631.0" prefWidth="830.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="salon.controller.client.ClientPriceListController">
    <children>
        <HBox alignment="CENTER_LEFT" style="-fx-background-color: #E8C0C5;">
            <children>
                <Button mnemonicParsing="false" onAction="#back" style="-fx-background-color: transparent; -fx-border-color: white; -fx-border-radius: 50; -fx-border-width: 2;" text="НАЗАД" textFill="WHITE">
                    <padding>
                        <Insets bottom="6.0" left="18.0" right="18.0" top="6.0" />
                    </padding>
                    <font>
                        <Font name="System Bold" size="11.0" />
                    </font>
                </Button>
                <Label text="ПРАЙС-ЛИСТ" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                    <HBox.margin>
                        <Insets left="24.0" />
                    </HBox.margin>
                </Label>
            </children>
            <padding>
                <Insets bottom="14.0" left="24.0" right="24.0" top="14.0" />
            </padding>
        </HBox>

        <VBox spacing="14.0" VBox.vgrow="ALWAYS">
            <children>
                <Label text="Каталог услуг" textFill="#758952">
                    <font>
                        <Font name="Serif Bold" size="28.0" />
                    </font>
                </Label>
                <TableView fx:id="tableView" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="categoryColumn" prefWidth="210.0" text="Категория" />
                        <TableColumn fx:id="nameColumn" prefWidth="260.0" text="Услуга" />
                        <TableColumn fx:id="durationColumn" prefWidth="150.0" text="Длительность" />
                        <TableColumn fx:id="priceColumn" prefWidth="150.0" text="Стоимость" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
            <padding>
                <Insets bottom="24.0" left="32.0" right="32.0" top="28.0" />
            </padding>
        </VBox>
    </children>
</VBox>
