<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="848.0" prefWidth="499.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="salon.controller.client.MasterInfoController" stylesheets="@../../css/styles.css">
    <padding>
        <Insets bottom="20.0" left="24.0" right="24.0" top="24.0" />
    </padding>
    <children>
      <ImageView fitHeight="77.0" fitWidth="75.0" preserveRatio="false">
         <image>
            <Image url="@../logo1.png" />
         </image>
      </ImageView>

                          <!-- Заголовок -->
        <Label text="Наши мастера" textFill="#758952">
            <font>
            <Font name="Serif Bold" size="37.0" />
         </font>
        </Label>
      <Label />
      <HBox prefHeight="100.0" prefWidth="200.0" />

              <!-- Фото + стрелки -->
        <HBox alignment="CENTER" spacing="12.0">
            <children>
                <Button mnemonicParsing="false" onAction="#prevMaster" style="-fx-background-color: transparent; -fx-cursor: hand;" text="❮">
                    <font><Font size="30.0" /></font>
                </Button>

                <StackPane prefHeight="250.0" prefWidth="250.0" style="-fx-border-color: #2b2b2b; -fx-border-width: 2;                                   -fx-background-color: #f9f0f1;">
                    <children>
                        <ImageView fx:id="masterPhoto" fitHeight="232.0" fitWidth="250.0" preserveRatio="true" />
                    </children>
                </StackPane>

                <Button mnemonicParsing="false" onAction="#nextMaster" style="-fx-background-color: transparent; -fx-cursor: hand;" text="❯">
                    <font><Font size="30.0" /></font>
                </Button>
            </children>
            <VBox.margin><Insets bottom="4.0" /></VBox.margin>
        </HBox>

              <!-- Счётчик -->
        <Label fx:id="pageLabel" text="1 / 1" textFill="#aaaaaa">
            <font>
            <Font size="12.0" />
         </font>
            <VBox.margin><Insets bottom="8.0" top="4.0" /></VBox.margin>
        </Label>

              <!-- Имя -->
        <Label fx:id="masterNameLabel" text="" textFill="#2b2b2b" wrapText="true">
            <font>
            <Font name="System Bold" size="17.0" />
         </font>
        </Label>

              <!-- Должность -->
        <Label fx:id="masterPositionLabel" text="" textFill="#758952">
            <font>
            <Font name="System Italic" size="14.0" />
         </font>
            <VBox.margin><Insets bottom="8.0" /></VBox.margin>
        </Label>

              <ScrollPane fitToWidth="true" maxWidth="422.0" prefHeight="523.0" prefWidth="422.0" style="-fx-border-color: #F4E2E4; -fx-border-width: 1; -fx-border-radius: 8;                    -fx-background-color: #fdf6f7; -fx-background-radius: 8;">
            <content>
                <Label fx:id="masterDescriptionLabel" alignment="TOP_LEFT" maxWidth="380.0" prefWidth="399.0" style="-fx-padding: 10;" text="" textFill="#555555" wrapText="true">
                    <font><Font size="16.0" /></font>
                </Label>
            </content>
        </ScrollPane>
      <Label prefHeight="29.0" prefWidth="28.0" />

              <!-- Кнопка выход -->
        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#close" style="-fx-background-color: #E8C0C5; -fx-background-radius: 10;" text="Выход" textFill="WHITE">
            <font>
            <Font name="System Bold" size="20.0" />
         </font>
            <padding>
            <Insets bottom="12.0" top="12.0" />
         </padding>
        </Button>

    </children>
</VBox>
