<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="700.0" prefWidth="900.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="salon.controller.client.ServiceCardsController">
    <children>
        <!-- Верхняя панель (Хедер) -->
        <HBox alignment="CENTER_LEFT" prefHeight="65.0" style="-fx-background-color: #E8C0C5;">
            <children>
                <Button mnemonicParsing="false" onAction="#goBack" style="-fx-background-color: transparent; -fx-border-color: white; -fx-border-radius: 50; -fx-border-width: 2;" text="НАЗАД" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="11.0" />
                    </font>
                    <padding>
                        <Insets bottom="6.0" left="18.0" right="18.0" top="6.0" />
                    </padding>
                </Button>
                <Region HBox.hgrow="ALWAYS" />
                <Label text="КАРТОЧКИ УСЛУГ" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <!-- Пустой регион справа для центровки заголовка -->
                <Region prefWidth="85.0" />
            </children>
            <padding>
                <Insets bottom="14.0" left="24.0" right="24.0" top="14.0" />
            </padding>
        </HBox>

        <!-- Контейнер для динамических карточек -->
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: white;" VBox.vgrow="ALWAYS">
            <content>
                <VBox fx:id="servicesContainer" alignment="TOP_CENTER" spacing="20.0">
                    <padding>
                        <Insets bottom="40.0" left="50.0" right="50.0" top="30.0" />
                    </padding>
                    <!-- Сюда контроллер будет добавлять карточки через код -->
                </VBox>
            </content>
        </ScrollPane>
    </children>
</VBox>