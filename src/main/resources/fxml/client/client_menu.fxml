<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="700.0" prefWidth="830.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="salon.controller.client.ClientMenuController" stylesheets="@../../css/styles.css">
    <children>
        <ImageView fitHeight="831.0" fitWidth="1030.0" pickOnBounds="true" preserveRatio="false" style="-fx-background-color: rgba(255, 255, 255, 0.78);">
            <image>
                <Image url="@../FON1.png" />
            </image>
        </ImageView>

        <VBox prefHeight="700.0" prefWidth="830.0" style="-fx-background-color: rgba(255, 255, 255, 0.78);">
            <children>
                <!-- Унифицированная верхняя панель -->
                <HBox alignment="CENTER_LEFT" prefHeight="85.0" prefWidth="1030.0" style="-fx-background-color: #E8C0C5;">
                    <children>
                        <Button fx:id="logoutButton" mnemonicParsing="false" onAction="#logout" prefHeight="45.0" prefWidth="134.0" style="-fx-background-color: transparent; -fx-border-color: white; -fx-border-radius: 50; -fx-border-width: 2;" text="ВЫЙТИ" textFill="WHITE">
                            <padding>
                                <Insets bottom="6.0" left="18.0" right="18.0" top="6.0" />
                            </padding>
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Button>
                    </children>
                    <padding>
                        <Insets bottom="14.0" left="24.0" right="24.0" top="14.0" />
                    </padding>
                </HBox>

                <VBox alignment="CENTER" spacing="25.0" VBox.vgrow="ALWAYS">
                    <children>
                        <!-- Логотип и приветствие -->
                        <VBox alignment="CENTER" spacing="5.0">
                            <children>
                                <ImageView fitHeight="130.0" fitWidth="130.0" preserveRatio="false">
                                    <image>
                                        <Image url="@../logo1.png" />
                                    </image>
                                </ImageView>
                                <Label text="ЭСТЕТИКА" textFill="#758952">
                                    <font>
                                        <Font name="Serif Bold" size="50.0" />
                                    </font>
                                </Label>
                                <Label text="ЛИЧНЫЙ КАБИНЕТ" textFill="#755f62">
                                    <font>
                                        <Font name="System Bold" size="18.0" />
                                    </font>
                                </Label>
                                <Label fx:id="welcomeLabel" text="Здравствуйте" textFill="#758952">
                                    <font>
                                        <Font name="System Bold" size="20.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>

                        <!-- Центральное меню: 5 кнопок -->
                        <VBox maxWidth="620.0" spacing="12.0">
                            <children>
                                <!-- Профиль -->
                                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#openProfile" prefHeight="60.0" style="-fx-background-color: #E5A9A9; -fx-background-radius: 10;" text="ПРОФИЛЬ" textFill="WHITE">
                                    <font>
                                        <Font name="System Bold" size="18.0" />
                                    </font>
                                </Button>

                                <!-- Мои записи -->
                                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#openAppointments" prefHeight="60.0" style="-fx-background-color: #E8C0C5; -fx-background-radius: 10;" text="МОИ ЗАПИСИ" textFill="WHITE">
                                    <font>
                                        <Font name="System Bold" size="18.0" />
                                    </font>
                                </Button>

                                <!-- Новая запись -->
                                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#openNewAppointment" prefHeight="60.0" style="-fx-background-color: #E5A9A9; -fx-background-radius: 10;" text="НОВАЯ ЗАПИСЬ" textFill="WHITE">
                                    <font>
                                        <Font name="System Bold" size="18.0" />
                                    </font>
                                </Button>

                                <!-- Карточки услуг -->
                                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#openServiceCards" prefHeight="60.0" style="-fx-background-color: #E8C0C5; -fx-background-radius: 10;" text="КАРТОЧКИ УСЛУГ" textFill="WHITE">
                                    <font>
                                        <Font name="System Bold" size="18.0" />
                                    </font>
                                </Button>

                                <!-- Прайс-лист -->
                                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#openPriceList" prefHeight="60.0" style="-fx-background-color: #E5A9A9; -fx-background-radius: 10;" text="ПРАЙС-ЛИСТ" textFill="WHITE">
                                    <font>
                                        <Font name="System Bold" size="18.0" />
                                    </font>
                                </Button>
                            </children>
                        </VBox>
                    </children>
                    <padding>
                        <Insets bottom="40.0" left="60.0" right="60.0" top="20.0" />
                    </padding>
                </VBox>
            </children>
        </VBox>
    </children>
</StackPane>