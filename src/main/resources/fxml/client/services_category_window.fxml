<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="560.0" prefWidth="920.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="salon.controller.client.ServicesCategoryController">
    <children>
        <ImageView fitHeight="560.0" fitWidth="920.0" pickOnBounds="true">
            <image>
                <Image url="@../FON1.png" />
            </image>
        </ImageView>
        <VBox spacing="20.0" style="-fx-background-color: rgba(255, 255, 255, 0.78);">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
            </padding>
            <children>
                <Label fx:id="titleLabel" text="Название категории" textFill="#758952">
                    <font>
                        <Font name="Serif Bold" size="34.0" />
                    </font>
                </Label>
                <TableView fx:id="tableView" style="-fx-background-color: rgba(255, 255, 255, 0.95); -fx-font-size: 14;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="nameColumn" prefWidth="190.0" text="Название услуги" />
                        <TableColumn fx:id="descriptionColumn" prefWidth="330.0" text="Описание" />
                        <TableColumn fx:id="priceColumn" prefWidth="110.0" text="Цена" />
                        <TableColumn fx:id="durationColumn" prefWidth="130.0" text="Длительность" />
                        <TableColumn fx:id="bookColumn" prefWidth="130.0" text="Записаться" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </children>
</StackPane>