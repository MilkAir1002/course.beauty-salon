<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="330.0" prefWidth="481.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <Label alignment="CENTER" prefHeight="64.0" prefWidth="345.0" text="Добавление/редактирование клиента" textAlignment="CENTER" textFill="#758952" wrapText="true">
         <font>
            <Font name="Serif Bold" size="24.0" />
         </font>
         <VBox.margin>
            <Insets top="20.0" />
         </VBox.margin>
      </Label>
      <VBox maxWidth="420.0" spacing="14.0">
         <children>
            <TextField fx:id="fullName" promptText="ФИО" style="-fx-background-radius: 10; -fx-border-color: #F4E2E4; -fx-border-radius: 10;" />
            <DatePicker fx:id="birthDate" maxWidth="1.7976931348623157E308" promptText="Дата рождения" style="-fx-background-radius: 10; -fx-border-color: #F4E2E4; -fx-border-radius: 10;" />
            <TextField fx:id="phone" promptText="Телефон" style="-fx-background-radius: 10; -fx-border-color: #F4E2E4; -fx-border-radius: 10;" />
            <TextField fx:id="password" alignment="TOP_LEFT" prefHeight="0.0" prefWidth="420.0" promptText="Пароль" style="-fx-background-radius: 10; -fx-border-color: #F4E2E4; -fx-border-radius: 10;" />
         </children>
         <VBox.margin>
            <Insets top="20.0" />
         </VBox.margin>
      </VBox>
      <Button fx:id="saveAppointmentButton" mnemonicParsing="false" prefHeight="44.0" prefWidth="114.0" style="-fx-background-color: #E8C0C5; -fx-background-radius: 10;" text="Добавить" textFill="WHITE">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
         <padding>
            <Insets bottom="12.0" top="12.0" />
         </padding>
         <VBox.margin>
            <Insets top="15.0" />
         </VBox.margin>
      </Button>
   </children>
</VBox>
